// Version resource of ac-dlssg-drs.exe. Windows names the program by its
// FileDescription in the UAC prompt of the elevated run.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION ACDB_VERSION_MAJOR,ACDB_VERSION_MINOR,ACDB_VERSION_PATCH,0
PRODUCTVERSION ACDB_VERSION_MAJOR,ACDB_VERSION_MINOR,ACDB_VERSION_PATCH,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "ac-dlssg driver profile helper (NVIDIA Smooth Motion off for Assetto Corsa)"
      VALUE "FileVersion", ACDB_VERSION
      VALUE "InternalName", "ac-dlssg-drs"
      VALUE "OriginalFilename", "ac-dlssg-drs.exe"
      VALUE "ProductName", "ac-dlssg"
      VALUE "ProductVersion", ACDB_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
